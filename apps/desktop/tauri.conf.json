{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CIPHER VAULT",
  "version": "../../package.json",
  "identifier": "io.github.termnix-it.ciphervault",
  "build": {
    "frontendDist": "../web/dist-tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "main-window",
          "description": "The only window, showing the bundled screen. It may call the app commands listed in build.rs and nothing else.",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-vault-status",
            "allow-vault-activity",
            "allow-vault-setup",
            "allow-vault-unlock",
            "allow-vault-lock",
            "allow-vault-reset",
            "allow-vault-maintenance",
            "allow-entries-list",
            "allow-entries-get",
            "allow-entries-create",
            "allow-entries-update",
            "allow-entries-delete",
            "allow-entries-set-group",
            "allow-password-generate",
            "allow-backup-export",
            "allow-backup-restore",
            "allow-vault-audit",
            "allow-clipboard-write",
            "allow-update-state",
            "allow-update-check",
            "allow-update-download",
            "allow-update-install",
            "allow-update-open-releases"
          ]
        }
      ],
      "freezePrototype": true,
      "csp": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; worker-src 'none'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../../build/icon.ico"
    ],
    "publisher": "Termnix-IT",
    "shortDescription": "CIPHER VAULT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/Termnix-IT/CIPHER-VAULT/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
